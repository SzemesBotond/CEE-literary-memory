values_to = "value"
) %>%
# keep ANY non-empty value (ignore NA / empty string)
filter(!is.na(value) & trimws(as.character(value)) != "") %>%
mutate(
wiki = str_extract(column, "^[^_]+")
) %>%
select(id, wiki)
