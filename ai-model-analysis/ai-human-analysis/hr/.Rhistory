# Load file
err <- read_excel("hr-error-human.xlsx")
folder <- "C:/Users/szemes/OneDrive - Tartu Ülikool/Desktop/munka/iti/wiki-visegrad/mi-modszer/2025-12-21/00-final-tables/authors/"
files <- list.files(
path = folder,
pattern = "\\.xlsx$",
full.names = TRUE
)
for (f in files) {
sheets <- excel_sheets(f)
dedup_sheets <- lapply(sheets, function(sh) {
df <- read_excel(f, sheet = sh)
# deduplicate rows (keep first)
df %>% distinct()
})
names(dedup_sheets) <- sheets
out_file <- file.path(
folder,
paste0(tools::file_path_sans_ext(basename(f)), "_dedup.xlsx")
)
write_xlsx(dedup_sheets, out_file)
}
